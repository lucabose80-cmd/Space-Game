{
  "name": "space-game",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:single": "tsc && vite build -c vite.single.config.ts",
    "preview": "vite preview",
    "test": "node tests/run.cjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "check:sprites": "node scripts/check-sprites.mjs",
    "verify": "npm run build && npm run check:invariants && npm run check:sprites && npm test",
    "art:import": "python3 scripts/art-import.py",
    "art:check": "python3 scripts/art-check.py",
    "art:gen": "python3 scripts/art-gen.py",
    "ship": "bash scripts/ship.sh"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "playwright": "1.63.0"
  },
  "dependencies": {
    "firebase": "^13.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
