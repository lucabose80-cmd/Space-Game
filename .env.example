# Firebase Configuration for STARLIGHTER Cloud-Save & Guild Scoreboard
# Copy these 6 values from Firebase Console -> Project Settings -> Your Apps (Web)
# and add them in Vercel -> Project Settings -> Environment Variables (or local .env.local):

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
